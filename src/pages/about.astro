---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import LogoMarquee from '@/components/LogoMarquee.astro';
import Faq from '@/components/Faq.astro';
import portrait from '@/assets/about/portrait.png';
import award from '@/assets/about/award.jpg';
import { aboutStats, awards, experience } from '@/data/site';

const aboutSocials = [
  { label: 'Facebook', href: 'https://www.facebook.com/', icon: 'facebook-sm' },
  { label: 'Instagram', href: 'https://www.instagram.com/', icon: 'instagram-sm' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/', icon: 'linkedin' },
] as const;
---

<BaseLayout title="About" description="I’m a web designer and developer in Manchester with over a decade of industry experience.">
  <div class="page-glow">
    <section class="container-page pt-8 md:pt-14">
      <div class="grid items-stretch gap-10 lg:grid-cols-[576px_1fr] lg:gap-[77px]">
        <div class="overflow-hidden rounded-section" data-reveal>
          <Image src={portrait} alt="Portrait of Andro" widths={[576, 1152]} sizes="(min-width: 1200px) 576px, 100vw" loading="eager" class="size-full object-cover" />
        </div>

        <div class="flex flex-col justify-between gap-12">
          <div data-reveal data-reveal-delay="0.1">
            <h1 class="text-[36px] leading-[1.2] font-bold md:text-5xl">I’m a web designer and developer in Manchester.</h1>
            <p class="mt-6 text-lg leading-[1.4] text-[#726c6c] md:text-2xl">
              With over a decade of industry experience, I specialize in creating visually appealing and functional websites.
            </p>
          </div>

          <dl class="flex flex-col gap-10" data-reveal data-reveal-delay="0.2">
            {
              aboutStats.map((stat) => (
                <div class="flex flex-col-reverse border-b border-line pb-3">
                  <dt class="mt-2 font-medium text-body">{stat.label}</dt>
                  <dd class="text-[40px] leading-[1.2] font-semibold">
                    <span data-counter={stat.value}>{stat.value}</span>{stat.suffix}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div class="flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="0.3">
            <Button href="/contact" variant="dark">Hire Me</Button>
            {
              aboutSocials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                  class="flex size-[54px] items-center justify-center rounded-full border border-line-soft transition-colors duration-300 hover:border-ink hover:bg-ink hover:text-white"
                >
                  <Icon name={s.icon} size={20} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <LogoMarquee />
  </div>

  <!-- Pengalaman kerja -->
  <section class="container-page pb-20 md:pb-[120px]">
    <div class="rounded-section bg-ink px-4 py-16 text-white md:px-6 md:py-[100px]">
      <h2 class="text-center text-[36px] leading-[1.2] font-bold md:text-[56px]" data-reveal>10 years of experience</h2>
      <ul class="mt-10 flex flex-col gap-6 md:mt-[60px]">
        {
          experience.map((job, i) => (
            <li
              class="group grid grid-cols-[48px_1fr] items-center gap-x-4 gap-y-2 rounded-[52px] border border-white/10 px-6 py-6 transition-colors duration-500 hover:border-accent/60 hover:bg-white/[0.03] md:grid-cols-[48px_1fr_336px_168px] md:px-7"
              data-reveal
              data-reveal-delay={i * 0.06}
            >
              <Image src={job.icon} alt="" width={48} height={48} class="row-span-2 md:row-span-1" />
              <h3 class="text-xl font-semibold md:text-2xl">{job.role}</h3>
              <a
                href={`https://${job.site}`}
                target="_blank"
                rel="noopener"
                class="col-start-2 text-accent hover:underline md:col-start-auto"
              >
                {job.site}
              </a>
              <p class="col-start-2 text-[#f2f2f2] md:col-start-auto">{job.period}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Penghargaan -->
  <section class="container-page pb-20 md:pb-[120px]">
    <div class="grid gap-10 lg:grid-cols-[538px_1fr] lg:gap-[115px]">
      <div class="overflow-hidden rounded-section" data-reveal>
        <Image src={award} alt="Silver trophy" widths={[538, 1076]} sizes="(min-width: 1200px) 538px, 100vw" class="size-full object-cover" />
      </div>
      <div class="lg:pt-2">
        <h2 class="text-[40px] leading-[1.2] font-bold md:text-[56px]" data-reveal>Awards</h2>
        <p class="mt-6 leading-[1.6] text-body" data-reveal>
          The if calculus is earnestly starting repeat by moving rethoric drunk or the caching lay if desk steps. A was him matters with of that breakfasts.
        </p>
        <ul class="mt-10 border-b border-line-soft md:mt-[60px]">
          {
            awards.map((a) => (
              <li class="grid grid-cols-[1fr_auto] gap-x-6 gap-y-2 border-t border-line-soft py-6 md:grid-cols-[207px_1fr_auto] md:py-[30px]" data-reveal>
                <p class="col-start-1 row-start-1 text-lg font-semibold">{a.name}</p>
                <p class="col-span-2 row-start-2 max-w-[194px] leading-[1.6] text-body md:col-span-1 md:col-start-2 md:row-start-1">
                  {a.description}
                </p>
                <p class="col-start-2 row-start-1 font-medium text-pill-dark md:col-start-3">{a.year}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Faq title="Frequently asked questions" />
</BaseLayout>
