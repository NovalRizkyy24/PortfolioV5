---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import LogoMarquee from '@/components/LogoMarquee.astro';
import { experience } from '@/data/site';
import { certificates, formatCertificateDate } from '@/data/certificates';

// Jumlah sertifikat yang langsung terlihat; sisanya lewat tombol "View all certificates"
const CERTIFICATES_SHOWN = 6;
// Versi besar untuk tampilan perbesar (lightbox)
const certificateCards = await Promise.all(
  certificates.map(async (cert) => ({ cert, full: (await getImage({ src: cert.image, width: Math.min(1600, cert.image.width) })).src })),
);

const aboutSocials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/novalrizky/', icon: 'linkedin' },
  { label: 'Instagram', href: 'https://www.instagram.com/novalrizky24_/', icon: 'instagram-sm' },
  { label: 'GitHub', href: 'https://github.com/NovalRizkyy24', icon: 'github' },
] as const;

// Semua foto di assets/about/potrait, diurutkan berdasarkan nomor file (1.png jadi foto pertama)
const portraits = Object.entries(import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/potrait/*.{png,jpg,jpeg,webp}', { eager: true }))
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);
---

<BaseLayout title="About" description="I’m a junior developer from Bandung, Indonesia, building web applications that combine backend logic, frontend design, and artificial intelligence.">
  <div class="page-glow">
    <section class="container-page pt-8 md:pt-14">
      <div class="grid items-stretch gap-10 lg:grid-cols-[576px_1fr] lg:gap-[77px]">
        <div class="group relative self-start overflow-hidden rounded-section" data-reveal data-portrait-slider>
          <div class="portrait-track flex aspect-square snap-x snap-mandatory overflow-x-auto" data-track>
            {
              portraits.map((img, i) => (
                <Image
                  src={img}
                  alt={`Portrait of Noval ${i + 1}`}
                  widths={[576, 1152]}
                  sizes="(min-width: 1200px) 576px, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="size-full shrink-0 snap-start object-cover"
                />
              ))
            }
          </div>

          <button
            type="button"
            class="absolute top-1/2 left-4 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 opacity-0 backdrop-blur transition duration-300 group-hover:opacity-100 hover:bg-white focus-visible:opacity-100"
            aria-label="Previous photo"
            data-prev
          >
            <Icon name="arrow-left" size={18} />
          </button>
          <button
            type="button"
            class="absolute top-1/2 right-4 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 opacity-0 backdrop-blur transition duration-300 group-hover:opacity-100 hover:bg-white focus-visible:opacity-100"
            aria-label="Next photo"
            data-next
          >
            <Icon name="arrow-right" size={18} />
          </button>
        </div>

        <div class="flex flex-col justify-between gap-12">
          <div data-reveal data-reveal-delay="0.1">
            <h1 class="text-[36px] leading-[1.2] font-bold md:text-5xl">I’m a junior developer</h1>
            <p class="mt-6 text-lg leading-[1.4] text-[#726c6c] md:text-2xl">
              As an Informatics graduate from Institut Teknologi Nasional Bandung, I build modern web applications that bring together solid backend logic, clean frontend design, and artificial intelligence.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="0.3">
            <Button href="/contact" variant="dark">Hire Me</Button>
            {
              aboutSocials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                  class="flex size-[54px] items-center justify-center rounded-full border border-line-soft transition-colors duration-300 hover:border-ink hover:bg-ink hover:text-white"
                >
                  <Icon name={s.icon} size={20} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <LogoMarquee />
  </div>

  <!-- Pengalaman: timeline dua sisi (bergantian kiri-kanan di desktop, satu kolom di mobile) -->
  <section class="container-page pb-20 md:pb-[120px]">
    <div class="rounded-section bg-ink px-5 py-16 text-white md:px-10 md:py-[100px]">
      <div class="text-center">
        <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase" data-reveal>Experience</p>
        <h2 class="mt-3 text-[36px] leading-[1.2] font-bold md:text-[56px]" data-reveal data-reveal-delay="0.05">Where I’ve been</h2>
      </div>

      <ol class="relative mx-auto mt-12 max-w-[1000px] md:mt-16">
        <span class="absolute inset-y-0 left-[7px] w-px bg-white/15 md:left-1/2 md:-translate-x-1/2" aria-hidden="true"></span>
        {
          experience.map((item, i) => {
            const left = i % 2 === 0;
            return (
              <li
                class:list={['relative pb-10 pl-10 last:pb-0 md:w-1/2 md:pl-0', left ? 'md:pr-14' : 'md:ml-auto md:pl-14']}
                data-reveal
                data-reveal-delay={i * 0.08}
              >
                <span
                  class:list={[
                    'absolute top-7 left-0 size-[15px] rounded-full border-2 border-accent bg-ink',
                    left ? 'md:right-0 md:left-auto md:translate-x-1/2' : 'md:-translate-x-1/2',
                  ]}
                  aria-hidden="true"
                ></span>
                <article class="rounded-card border border-white/10 bg-white/[0.03] p-6 transition-colors duration-500 hover:border-accent/60 md:p-7">
                  <div class="flex flex-wrap items-center gap-3">
                    <p class="font-semibold text-accent">{item.period}</p>
                    <span class="rounded-full border border-white/15 px-3 py-1 text-xs font-medium text-[#cfcfcf]">{item.type}</span>
                  </div>
                  <h3 class="mt-4 text-xl leading-[1.3] font-semibold md:text-2xl">{item.title}</h3>
                  <p class="mt-1 text-[#bdbaba]">{item.org}</p>
                  {item.points.length > 0 && (
                    <ul class="mt-4 list-disc space-y-1.5 pl-5 leading-[1.6] text-[#e6e6e6] marker:text-accent">
                      {item.points.map((point) => <li>{point}</li>)}
                    </ul>
                  )}
                </article>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- Sertifikat: kartu seragam berbingkai (portrait & landscape tampil utuh), klik untuk memperbesar.
       Dari Home dibuka dengan ?view=certificates sehingga semua sertifikat langsung terlihat. -->
  <section id="certificates" class="container-page scroll-mt-24 pb-20 md:pb-[120px]">
    <div class="mb-10 text-center md:mb-14">
      <p class="text-sm font-semibold tracking-[0.2em] text-body uppercase" data-reveal>Certificates</p>
      <h2 class="mt-3 text-[36px] leading-[1.2] font-bold md:text-[56px]" data-reveal data-reveal-delay="0.05">Learning never stops</h2>
    </div>

    <ul id="certificate-list" class="grid gap-5 md:grid-cols-2 md:gap-[30px] lg:grid-cols-3">
      {
        certificateCards.map(({ cert, full }, i) => (
          <li class:list={[i >= CERTIFICATES_SHOWN && 'hidden']} data-hidden={i >= CERTIFICATES_SHOWN ? '' : undefined} data-reveal>
            <article class="flex h-full flex-col">
              <button
                type="button"
                class="group flex aspect-[4/3] items-center justify-center overflow-hidden rounded-card bg-surface p-5 md:p-7"
                aria-label={`View ${cert.title} certificate`}
                data-cert-open={full}
                data-cert-title={cert.title}
                data-cert-meta={`${cert.issuer} · ${formatCertificateDate(cert.date)}`}
              >
                <Image
                  src={cert.image}
                  alt={`${cert.title} certificate`}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 1200px) 400px, (min-width: 810px) 50vw, 100vw"
                  loading="lazy"
                  class="max-h-full w-auto max-w-full object-contain shadow-[0_12px_30px_-12px_rgba(10,11,10,0.35)] transition-transform duration-500 ease-out-quint group-hover:-translate-y-1.5"
                />
              </button>
              <h3 class="mt-5 text-xl leading-[1.3] font-semibold">{cert.title}</h3>
              <div class="mt-1 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-body">
                <p>{cert.issuer} · {formatCertificateDate(cert.date)}</p>
                {cert.credentialUrl && (
                  <a href={cert.credentialUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-ink underline underline-offset-2 hover:text-body">
                    Verify <Icon name="arrow-up-right" size={14} />
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    {
      certificateCards.length > CERTIFICATES_SHOWN && (
        <div class="mt-12 flex justify-center">
          <Button type="button" data-load-more="certificate-list" data-cert-more>Load More</Button>
        </div>
      )
    }

    <!-- Lightbox layar penuh: panah kiri/kanan, tombol keyboard ← → Esc, dan geser di HP -->
    <dialog
      class="fixed inset-0 m-0 h-svh max-h-none w-screen max-w-none overflow-hidden bg-ink/95 p-0 text-white backdrop:bg-transparent"
      aria-label="Certificate viewer"
      data-cert-dialog
    >
      <div class="flex h-full flex-col">
        <div class="flex items-center justify-between gap-4 px-4 pt-4 md:px-8 md:pt-6">
          <p class="text-sm font-medium tracking-[0.15em] text-white/60 tabular-nums" data-cert-counter></p>
          <button
            type="button"
            class="flex size-11 items-center justify-center rounded-full bg-white/10 text-2xl leading-none transition-colors duration-300 hover:bg-white hover:text-ink"
            aria-label="Close"
            data-cert-close
          >
            ×
          </button>
        </div>

        <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 py-4 md:px-24" data-cert-stage>
          <img src="" alt="" class="max-h-full max-w-full rounded-card object-contain shadow-2xl select-none" draggable="false" data-cert-image />
          <button
            type="button"
            class="absolute top-1/2 left-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 ring-1 ring-white/20 backdrop-blur transition-colors duration-300 hover:bg-white hover:text-ink md:left-8"
            aria-label="Previous certificate"
            data-cert-prev
          >
            <Icon name="arrow-left" size={20} />
          </button>
          <button
            type="button"
            class="absolute top-1/2 right-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 ring-1 ring-white/20 backdrop-blur transition-colors duration-300 hover:bg-white hover:text-ink md:right-8"
            aria-label="Next certificate"
            data-cert-next
          >
            <Icon name="arrow-right" size={20} />
          </button>
        </div>

        <div class="px-4 pb-6 text-center md:pb-8">
          <p class="text-lg font-semibold md:text-xl" data-cert-caption></p>
          <p class="mt-1 text-white/60" data-cert-caption-meta></p>
          <p class="mt-3 text-xs text-white/40 md:hidden">Swipe to see other certificates</p>
        </div>
      </div>
    </dialog>
  </section>
</BaseLayout>

<style>
  .portrait-track {
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .portrait-track::-webkit-scrollbar {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  // Slider foto: geser (swipe/scroll) atau pakai tombol panah
  document.querySelectorAll<HTMLElement>('[data-portrait-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('[data-track]')!;
    const prev = slider.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = slider.querySelector<HTMLButtonElement>('[data-next]')!;

    const count = track.children.length;

    // Looping mulus: salinan foto terakhir di depan dan salinan foto pertama di belakang.
    // Dari foto terakhir, slider tetap bergeser ke kanan ke salinan foto 1, lalu diam-diam
    // melompat ke foto 1 yang asli (begitu juga sebaliknya ke arah kiri).
    const slides = [...track.children] as HTMLElement[];
    const firstClone = slides[0].cloneNode(true) as HTMLElement;
    const lastClone = slides[count - 1].cloneNode(true) as HTMLElement;
    [firstClone, lastClone].forEach((el) => {
      el.setAttribute('aria-hidden', 'true');
      el.setAttribute('alt', '');
    });
    track.append(firstClone);
    track.prepend(lastClone);

    // Posisi slot di track: 0 = salinan terakhir, 1..count = foto asli, count + 1 = salinan pertama
    const slot = () => Math.round(track.scrollLeft / track.clientWidth);
    const jumpTo = (s: number) => {
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = s * track.clientWidth;
      track.style.scrollBehavior = '';
    };
    const goTo = (s: number) => track.scrollTo({ left: s * track.clientWidth });

    const settle = () => {
      const s = slot();
      if (s === 0) jumpTo(count);
      else if (s === count + 1) jumpTo(1);
    };

    let settleTimer: number;
    track.addEventListener(
      'scroll',
      () => {
        clearTimeout(settleTimer);
        settleTimer = window.setTimeout(settle, 120);
      },
      { passive: true },
    );

    prev.addEventListener('click', () => goTo(slot() - 1));
    next.addEventListener('click', () => goTo(slot() + 1));
    window.addEventListener('resize', () => jumpTo(slot()));

    jumpTo(1);
  });

  // Lightbox sertifikat: klik kartu untuk membuka; panah / tombol ← → / geser untuk pindah;
  // Esc, tombol ×, atau klik area gelap di luar gambar untuk menutup
  const certDialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]');
  if (certDialog) {
    const certButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-cert-open]')];
    const image = certDialog.querySelector<HTMLImageElement>('[data-cert-image]')!;
    const stage = certDialog.querySelector<HTMLElement>('[data-cert-stage]')!;
    const caption = certDialog.querySelector<HTMLElement>('[data-cert-caption]')!;
    const captionMeta = certDialog.querySelector<HTMLElement>('[data-cert-caption-meta]')!;
    const counter = certDialog.querySelector<HTMLElement>('[data-cert-counter]')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + certButtons.length) % certButtons.length;
      const { certOpen, certTitle, certMeta } = certButtons[current].dataset;
      image.src = certOpen!;
      image.alt = `${certTitle} certificate`;
      caption.textContent = certTitle!;
      captionMeta.textContent = certMeta!;
      counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(certButtons.length).padStart(2, '0')}`;
      // Muat duluan sertifikat sebelah supaya perpindahan terasa instan
      [current - 1, current + 1].forEach((i) => {
        new Image().src = certButtons[(i + certButtons.length) % certButtons.length].dataset.certOpen!;
      });
    };

    certButtons.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        show(i);
        certDialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );
    certDialog.addEventListener('close', () => (document.documentElement.style.overflow = ''));

    certDialog.querySelector('[data-cert-prev]')!.addEventListener('click', () => show(current - 1));
    certDialog.querySelector('[data-cert-next]')!.addEventListener('click', () => show(current + 1));
    certDialog.querySelector('[data-cert-close]')!.addEventListener('click', () => certDialog.close());
    stage.addEventListener('click', (e) => {
      if (e.target === stage) certDialog.close();
    });
    // Esc sudah ditangani <dialog> secara bawaan
    certDialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Geser di layar sentuh: ke kiri = berikutnya, ke kanan = sebelumnya
    let startX = 0;
    let startY = 0;
    stage.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    });
  }

  // Datang dari kontainer sertifikat di Home (?view=certificates): tampilkan semua lalu gulir ke section-nya
  if (new URLSearchParams(location.search).get('view') === 'certificates') {
    document.querySelectorAll<HTMLElement>('#certificate-list [data-hidden]').forEach((item) => {
      item.removeAttribute('data-hidden');
      item.classList.remove('hidden');
    });
    document.querySelector('[data-cert-more]')?.remove();
    const scrollToCertificates = () => document.getElementById('certificates')?.scrollIntoView();
    // Selama layar pembuka tampil halaman tidak bisa digulir, jadi tunggu sampai selesai
    if (document.documentElement.classList.contains('preloading')) {
      window.addEventListener('preloader:done', scrollToCertificates, { once: true });
    } else {
      requestAnimationFrame(scrollToCertificates);
    }
  }
</script>
