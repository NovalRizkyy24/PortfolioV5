---
// Halaman uji navbar fixed: gambar background penuh + tinggi 200vh. Hapus file ini kalau sudah tidak dipakai.
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import hero from '@/assets/home/hero.jpeg';

const bg = await getImage({ src: hero, width: 1920, format: 'webp' });
---

<BaseLayout title="Navbar Test" overlayHeader footerCta={false}>
  <section class="navbar-test" style={`background-image: url(${bg.src})`}>
    <p>Scroll ke bawah — navbar harus tetap di atas dan gambar terlihat blur di baliknya.</p>
  </section>
</BaseLayout>

<style>
  .navbar-test {
    min-height: 200vh;
    padding: 140px 40px;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    color: #fff;
    font-size: 20px;
    font-weight: 600;
  }
</style>
