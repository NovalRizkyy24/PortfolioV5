---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/react/ContactForm';
import { contactPurposes, site } from '@/data/site';
---

<BaseLayout title="Contact" description="I’m available for hire. Let’s discuss your next project together.">
  <section class="container-page pt-8 pb-20 md:pt-14 md:pb-[120px]">
    <div class="mx-auto max-w-[720px]">
      <header class="mb-10 md:mb-14">
        <p class="text-sm font-semibold tracking-[0.2em] text-muted" data-reveal>GET IN TOUCH</p>
        <h1 class="contact-heading mt-4 text-[48px] leading-[0.95] md:text-[88px]" data-reveal data-reveal-delay="0.1">
          Let’s work together.
        </h1>
        <p class="mt-5 max-w-[480px] text-lg leading-[1.5] text-body" data-reveal data-reveal-delay="0.2">
          Have a project in mind or just want to say hello? Send me a message.
        </p>
      </header>

      <div data-reveal data-reveal-delay="0.3">
        <ContactForm client:visible purposes={contactPurposes} fallbackEmail={site.email} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-heading {
    font-family: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
</style>
