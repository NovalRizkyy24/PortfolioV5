---
import { Image, getImage } from 'astro:assets';
import outline from '@/assets/home/testimonials-outline.png';
import { testimonials } from '@/data/site';
import TestimonialSlider, { type TestimonialItem } from '@/components/react/TestimonialSlider';

const items: TestimonialItem[] = await Promise.all(
  testimonials.map(async (t) => {
    const img = await getImage({ src: t.image, widths: [400, 800], format: 'webp' });
    return { quote: t.quote, name: t.name, role: t.role, image: { src: img.src, srcset: img.srcSet.attribute } };
  }),
);
---

<section class="pb-20 md:pb-[120px]">
  <!-- Teks outline "TESTIMONIALS •" yang berjalan -->
  <h2 class="sr-only">Testimonials</h2>
  <div class="overflow-hidden py-6 md:py-10" aria-hidden="true">
    <div class="marquee-track" style="--marquee-duration: 25s">
      {
        [0, 1, 2, 3].map(() => (
          <div class="flex shrink-0 items-center">
            <Image src={outline} alt="" width={931} class="h-10 w-auto md:h-[72px] lg:h-[100px]" />
            <span class="mx-6 size-4 rounded-full bg-ink md:mx-[34px] md:size-6" />
          </div>
        ))
      }
    </div>
  </div>

  <div class="container-page mt-10 md:mt-[60px]" data-reveal>
    <TestimonialSlider client:visible items={items} />
  </div>
</section>
