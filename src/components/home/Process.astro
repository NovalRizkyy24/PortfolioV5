---
import { Image } from 'astro:assets';
import { process } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import discovery from '@/assets/process/discovery.svg';
import wireframe from '@/assets/process/wireframe.svg';
import design from '@/assets/process/design.svg';
import build1 from '@/assets/process/build-1.svg';
import build2 from '@/assets/process/build-2.svg';
import build3 from '@/assets/process/build-3.svg';
import deliver1 from '@/assets/process/deliver-1.svg';
import deliver2 from '@/assets/process/deliver-2.svg';

const steps = [
  { ...process.discovery, icon: discovery, ring: 'border-ink' },
  { ...process.wireframe, icon: wireframe, ring: 'border-[#5a61f5]' },
  { ...process.design, icon: design, ring: 'border-accent' },
];
const card = 'relative overflow-hidden rounded-card bg-white px-6 py-8 md:px-10 md:py-12';
const bubble = 'flex items-center justify-center rounded-full border border-line-soft bg-white';
---

<section class="container-page pb-20 md:pb-[120px]">
  <div class="rounded-section bg-surface px-3 py-16 md:px-6 md:py-[120px]">
    <h2 class="mx-auto max-w-[700px] text-center text-[32px] leading-[1.2] font-bold md:text-[56px]" data-reveal>
      My reliable and effective design process
    </h2>

    <div class="mt-10 grid gap-6 md:mt-[60px] md:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((step, i) => (
          <article class={card} data-reveal data-reveal-delay={i * 0.1}>
            <div class:list={['flex size-16 items-center justify-center rounded-full border md:size-20', step.ring]}>
              <Image src={step.icon} alt="" width={32} height={32} />
            </div>
            <h3 class="mt-8 text-2xl leading-[1.3] font-semibold md:mt-[44px] md:text-[28px]">{step.title}</h3>
            <p class="mt-4 leading-[1.6] text-body">{step.description}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <!-- Build -->
      <article class={card} data-reveal>
        <div class="absolute -top-4 right-[60px] size-[258px] rounded-full bg-accent-soft opacity-60 blur-[80px]"></div>
        <div class="relative grid gap-8 sm:grid-cols-[230px_1fr]">
          <div class="sm:pt-14">
            <h3 class="text-2xl leading-[1.3] font-semibold md:text-[28px]">{process.build.title}</h3>
            <p class="mt-4 leading-[1.6] text-[#726c6c]">{process.build.description}</p>
          </div>
          <div class="relative h-[180px] sm:h-auto" aria-hidden="true">
            <div class:list={[bubble, 'float absolute top-[72px] left-[10%] size-[81px]']}>
              <Image src={build1} alt="" width={29} height={29} />
            </div>
            <div class:list={[bubble, 'float absolute top-0 left-[45%] size-[81px] border-accent']} style="--delay: -1.2s">
              <Image src={build2} alt="" width={29} height={29} />
            </div>
            <div class:list={[bubble, 'float absolute top-[152px] left-[35%] size-[81px]']} style="--delay: -2.4s">
              <Image src={build3} alt="" width={29} height={29} />
            </div>
          </div>
        </div>
      </article>

      <!-- Deliver -->
      <article class={card} data-reveal data-reveal-delay="0.1">
        <div class="absolute -top-10 -right-6 size-[236px] rounded-full bg-lavender opacity-50 blur-[80px]"></div>
        <div class="relative grid gap-8 sm:grid-cols-[230px_1fr]">
          <div class="sm:pt-14">
            <h3 class="text-2xl leading-[1.3] font-semibold md:text-[28px]">{process.deliver.title}</h3>
            <p class="mt-4 leading-[1.6] text-[#726c6c]">{process.deliver.description}</p>
          </div>
          <div class="flex items-center justify-center gap-5 sm:pt-24" aria-hidden="true">
            <div class:list={[bubble, 'float size-[85px]']}>
              <Image src={deliver1} alt="" width={31} height={31} />
            </div>
            <Icon name="arrow-right" size={24} class="arrow-nudge" />
            <div class:list={[bubble, 'float size-[85px] border-accent']} style="--delay: -1.5s">
              <Image src={deliver2} alt="" width={31} height={31} />
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .float {
    animation: float 4s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  :global(.arrow-nudge) {
    animation: nudge 1.6s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .float,
    :global(.arrow-nudge) {
      animation: none;
    }
  }
</style>
