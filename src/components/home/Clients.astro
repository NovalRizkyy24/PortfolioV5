---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';

// Logo klien diurutkan sesuai grid: baris 1 = [lebar, kecil, kecil, kecil], baris 2 = [kecil, kecil, kecil, lebar]
const logos = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/clients/*.svg', { eager: true }),
).map((m) => m.default);
const wide = new Set([0, logos.length - 1]);
---

<section class="container-page pb-20 md:pb-[120px]">
  <div class="rounded-section bg-ink px-5 py-16 text-white md:px-6 md:py-[120px]">
    <div class="grid gap-6 text-center md:text-left lg:grid-cols-[308px_1fr] lg:gap-0">
      <p class="font-semibold text-accent" data-reveal>My previous clients</p>
      <div class="flex flex-col gap-6 lg:flex-row lg:justify-between">
        <h2 class="text-[32px] leading-[1.2] font-bold lg:max-w-[274px] lg:text-[40px]" data-reveal>Work I have done for them</h2>
        <div class="mx-auto max-w-[330px] md:mx-0" data-reveal data-reveal-delay="0.1">
          <p class="leading-[1.6] text-[#f5f5f5]">
            I’m always open to new opportunities and conversations. Drop me a message, and let’s connect about your ideas or projects!
          </p>
          <a href="/portfolio" class="group mt-8 inline-flex items-center gap-1.5 px-1.5 font-medium text-accent underline underline-offset-4">
            See my latest work
            <Icon name="arrow-circle" size={16} class="transition-transform duration-300 group-hover:rotate-45" />
          </a>
        </div>
      </div>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-4 md:mt-[84px] md:gap-6 lg:ml-[308px] lg:grid-cols-5">
      {
        logos.map((logo, i) => (
          <li
            class:list={[
              'group flex h-[140px] items-center justify-center rounded-2xl bg-tile md:h-[262px]',
              wide.has(i) && 'lg:col-span-2',
            ]}
            data-reveal
            data-reveal-delay={(i % 4) * 0.08}
          >
            <Image
              src={logo}
              alt={`Client logo ${i + 1}`}
              class:list={[
                'h-auto opacity-70 transition duration-500 group-hover:scale-110 group-hover:opacity-100',
                wide.has(i) ? 'w-[60px] md:w-[89px]' : 'w-[50px] md:w-[67px]',
              ]}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
