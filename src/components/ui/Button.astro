---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'accent' | 'outline' | 'dark' | 'outline-light';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  href?: string;
  variant?: Variant;
  size?: 'sm' | 'md';
};

const { href, variant = 'accent', size = 'md', class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  accent: 'bg-accent text-ink hover:bg-ink hover:text-white',
  dark: 'bg-ink text-white hover:bg-accent hover:text-ink',
  outline: 'border border-line text-ink hover:border-ink hover:bg-ink hover:text-white',
  'outline-light': 'border border-white/20 text-white hover:border-accent hover:bg-accent hover:text-ink',
};
const sizes = {
  sm: 'h-10 px-5 text-sm',
  md: 'h-12 px-7 text-base',
};
const classes = [
  'inline-flex items-center justify-center gap-2 rounded-full font-medium whitespace-nowrap transition-colors duration-300',
  variants[variant],
  sizes[size],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
