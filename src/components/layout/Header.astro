---
import { nav } from '@/data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-nav">
  <a href="/" class="site-nav__logo">novalrizky</a>

  <nav aria-label="Main">
    <ul class="site-nav__menu">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="site-nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
              <span>{item.label}</span>
              <span aria-hidden="true">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 40px 28px;
    background: transparent;
    font-family: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
    color: #fff;
    /* Teks putih dibalik terhadap latar: tetap putih di atas hero gelap, jadi hitam di atas latar terang */
    mix-blend-mode: difference;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .site-nav__logo {
    display: inline-block;
    font-size: 44px;
    line-height: 1;
    font-weight: 800;
    text-transform: lowercase;
    transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .site-nav__logo:hover {
    transform: scale(1.12);
  }

  .site-nav__menu {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Text roll: dua salinan teks ditumpuk, link hanya setinggi satu baris */
  .site-nav__link {
    display: block;
    height: 1em;
    overflow: hidden;
    font-size: 20px;
    line-height: 1;
    font-weight: 700;
    text-transform: uppercase;
  }
  .site-nav__link span {
    display: block;
    transition: transform 0.45s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .site-nav__link:hover span,
  .site-nav__link:focus-visible span {
    transform: translateY(-100%);
  }

  @media (max-width: 600px) {
    .site-nav {
      padding: 6px 16px 20px;
      gap: 10px;
    }
    .site-nav__logo {
      font-size: clamp(20px, 6vw, 28px);
    }
    .site-nav__menu {
      gap: 10px;
    }
    .site-nav__link {
      font-size: clamp(11px, 3.3vw, 14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__logo,
    .site-nav__link span {
      transition: none;
    }
  }
</style>
