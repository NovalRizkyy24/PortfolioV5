---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  eager?: boolean;
}

const { project, class: className, eager = false } = Astro.props;
const { title, tag, cover } = project.data;
---

<a
  href={`/portfolio/${project.id}`}
  class:list={['group relative block aspect-[7/6] overflow-hidden rounded-card bg-ink md:aspect-2/1 md:rounded-section', className]}
  data-view-case
>
  <Image
    src={cover}
    alt={title}
    widths={[640, 1280, 1600]}
    sizes="(min-width: 1440px) 1280px, 100vw"
    loading={eager ? 'eager' : 'lazy'}
    class="size-full object-cover transition-transform duration-[1.2s] ease-out-quint group-hover:scale-105"
  />
  <div class="absolute inset-0 bg-linear-to-t from-black/60 via-black/10 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-5 text-white md:p-[38px]">
    <span class="inline-block rounded-full bg-white/25 px-4 py-2 text-base font-semibold backdrop-blur-[50px] md:px-7 md:py-[11px] md:text-xl">
      {tag}
    </span>
    <h3 class="mt-3 text-2xl leading-[1.2] font-bold md:mt-5 md:text-5xl">{title}</h3>
  </div>
</a>
