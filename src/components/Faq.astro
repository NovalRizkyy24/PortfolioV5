---
import { faqs } from '@/data/site';
import FaqAccordion from '@/components/react/FaqAccordion';

interface Props {
  title?: string;
}

const { title = 'Frequently asked Questions' } = Astro.props;
---

<section class="container-page pb-20 md:pb-[120px]">
  <div class="mx-auto max-w-[732px]">
    <h2 class="mb-10 text-center text-[32px] leading-[1.2] font-bold md:mb-[60px] md:text-5xl" data-reveal>{title}</h2>
    <div data-reveal>
      <FaqAccordion client:visible items={faqs} />
    </div>
  </div>
</section>
